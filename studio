#!/usr/bin/env bash
# Open the studio: always Opus 5.5, effort medium or higher (default high).
#   ./studio                  -> high
#   ./studio xhigh            -> any of: medium | high | xhigh | max
#   KITE_EFFORT=max ./studio  -> same, via the environment
# Inside a session, /effort can be changed freely, as long as it stays at medium or above.
cd "$(dirname "$0")" || exit 1

effort="${KITE_EFFORT:-high}"
case "${1:-}" in
  medium|high|xhigh|max) effort="$1"; shift ;;
  low|minimal|none) effort="$1"; shift ;;
esac
for arg in "$@"; do
  case "$arg" in
    --model*|--effort*) echo "Studio luôn dùng Opus 5.5; chọn mức nỗ lực bằng: ./studio [medium|high|xhigh|max]"; exit 1 ;;
  esac
done
case "$effort" in
  medium|high|xhigh|max) ;;
  *) echo "Mức nỗ lực '$effort' quá thấp. Studio cần từ medium trở lên: ./studio [medium|high|xhigh|max]"; exit 1 ;;
esac

exec claude --model claude-opus-5-5 --effort "$effort" "$@"
